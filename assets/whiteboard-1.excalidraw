    },
    {
      "id": "rkXksIWYJEIjzbsmR2qJG",
      "type": "text",
      "x": -143.88408490578158,
      "y": 1254.9211463166553,
      "width": 740.1236572265625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1266883742,
      "version": 126,
      "versionNonce": 1040404510,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "IIYEr-LcsB7R5W_tpG1nI",
          "type": "arrow"
        }
      ],
      "updated": 1779133259256,
      "link": null,
      "locked": false,
      "text": "An autonomous agent that lives on your server,\nremembers what it learns, and gets more capable the\nlonger it runs.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An autonomous agent that lives on your server, remembers what it learns, and gets more capable the longer it runs.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
